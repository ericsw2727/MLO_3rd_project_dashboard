DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=nodeverse
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Optional separate, disposable test database (requires CREATE/DROP privileges)
MYSQL_TEST_DATABASE=test_nodeverse
# Empty disables administrator registration. Generate a separate random secret locally.
ADMIN_REGISTRATION_CODE=
# Server-to-server only. Never embed this key in Unity or browser clients.
GAME_SERVER_API_KEY=
# MongoDB log storage. Required before migrate/check_mongodb/runserver.
MONGODB_URI=
MONGODB_DATABASE=nodeverse_logs
